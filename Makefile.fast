# Research tooling; compiler sources and their licenses remain unchanged.
PYTHON ?= python3
JOBS ?= 4
.NOTPARALLEL:
.PHONY: help bootstrap proofs compiler bench baseline guard test-harness correctness verify test-inline
help:
	@echo 'make -f Makefile.fast baseline  # bootstrap, full + incremental proofs, build, benchmark'
	@echo 'make -f Makefile.fast bench     # two independent measurement blocks + noise gate'
	@echo 'make -f Makefile.fast proofs    # full kernel check + one-file rebuild timing'
	@echo 'make -f Makefile.fast verify    # correctness suite, native regressions, ABI and PIC'
bootstrap:
	./perf/bootstrap.sh
guard:
	$(PYTHON) perf/guard.py
test-harness:
	$(PYTHON) -m unittest discover -s perf -p 'test_*.py'
test-inline: compiler
	$(PYTHON) perf/check_inline.py
proofs: guard
	./perf/in-env $(PYTHON) perf/proofs.py --jobs $(JOBS)
compiler:
	./perf/in-env $(MAKE) -j$(JOBS) all
bench: compiler
	$(PYTHON) perf/bench.py --output perf/results/latest.json
correctness: compiler
	$(PYTHON) perf/bench.py --correctness-only --output perf/results/correctness.json
verify: guard test-harness compiler correctness
	./perf/in-env $(MAKE) -C test -j$(JOBS) all
	./perf/in-env $(MAKE) -C test test
verify: test-inline
baseline: bootstrap test-harness proofs compiler
	$(PYTHON) perf/bench.py --output perf/results/baseline.json
