# Research tooling; preserve principal theorem statements and trusted semantics.
PYTHON ?= python3
JOBS ?= 4
.NOTPARALLEL:
.PHONY: help bootstrap proofs compiler bench baseline guard test-harness correctness verify test-validators test-experiments test-neon test-loops test-memory-loops test-compatibility compare-assembly
help:
	@echo 'make -f Makefile.fast baseline  # bootstrap, full + incremental proofs, build, benchmark'
	@echo 'make -f Makefile.fast bench     # two independent measurement blocks + noise gate'
	@echo 'make -f Makefile.fast proofs    # full kernel check + one-file rebuild timing'
	@echo 'make -f Makefile.fast verify    # correctness suite, native regressions, ABI and PIC'
	@echo 'make -f Makefile.fast test-experiments # proved experimental passes, independent and combined'
	@echo 'make -f Makefile.fast compare-assembly # ARM64 static comparison with clang -O2; no executable runs'
	@echo 'make -f Makefile.fast test-loops # LICM, induction, peeling, automatic NEON correctness'
	@echo 'make -f Makefile.fast test-memory-loops # memory widening, fusion, interchange and tiling correctness'
	@echo 'make -f Makefile.fast test-compatibility # strict failures, reference retry and mixed native linkage'
	@echo 'make -f Makefile.fast test-neon # integer model against native NEON, no speed series'
bootstrap:
	./perf/bootstrap.sh
guard:
	$(PYTHON) perf/guard.py
test-harness:
	$(PYTHON) -m unittest discover -s perf -p 'test_*.py'
proofs:
	./perf/in-env $(PYTHON) perf/proofs.py --jobs $(JOBS)
compiler: guard
	./perf/in-env $(PYTHON) -c 'from pathlib import Path; Path("extraction/STAMP").unlink(missing_ok=True)'
	./perf/in-env $(MAKE) -j$(JOBS) all
test-validators: compiler
	$(PYTHON) perf/check_validators.py
test-loops: compiler
	$(PYTHON) perf/check_lowerlong.py
	$(PYTHON) perf/check_licm.py
	$(PYTHON) perf/check_preheader_licm.py
	$(PYTHON) perf/check_strengthreduce.py
	$(PYTHON) perf/check_peel.py
	$(PYTHON) perf/check_vectorize.py
	$(PYTHON) perf/check_loop_optimizations.py
test-memory-loops: compiler
	$(PYTHON) perf/check_arraypair_wide.py
	$(PYTHON) perf/check_arraypair.py
	$(PYTHON) perf/check_autopair.py
	$(PYTHON) perf/check_pointerneon.py
	$(PYTHON) perf/check_memoryneon.py
	$(PYTHON) perf/check_peeltwo.py
	$(PYTHON) perf/check_memvector.py
	$(PYTHON) perf/check_loopfusion.py
	$(PYTHON) perf/check_loopinterchange.py
	$(PYTHON) perf/check_looptile.py
	$(PYTHON) perf/check_looptile2d.py
	$(PYTHON) perf/check_memory_loops.py
test-experiments: compiler test-loops test-memory-loops
	$(PYTHON) perf/check_heuristics.py
	$(PYTHON) perf/check_select.py
	$(PYTHON) perf/check_scalar.py
	$(PYTHON) perf/check_hoist.py
	$(PYTHON) perf/check_schedule.py
	$(PYTHON) perf/check_loadforward.py
	$(PYTHON) perf/check_storeelim.py
	$(PYTHON) perf/check_unswitch.py
	$(PYTHON) perf/check_packed_neon.py
	$(PYTHON) perf/check_experiments.py
compare-assembly: compiler
	$(PYTHON) perf/compare_assembly.py
	$(PYTHON) perf/compare_memory_loops.py
test-neon: guard
	$(PYTHON) perf/check_neon.py
test-compatibility: compiler
	$(PYTHON) perf/check_compilation_compatibility.py
bench: compiler
	$(PYTHON) perf/bench.py --output perf/results/latest.json
correctness: compiler
	$(PYTHON) perf/bench.py --correctness-only --output perf/results/correctness.json
# Ordinary correctness checks must observe the optimized path. The dedicated
# compatibility suite sets the mode explicitly for each attempt.
verify test-validators test-loops test-memory-loops test-experiments compare-assembly: export COMPCERT_EXPERIMENT_FALLBACK = 0
verify: guard test-harness compiler correctness test-validators test-experiments test-neon compare-assembly test-compatibility
	$(PYTHON) perf/check_native_profiles.py --jobs $(JOBS)
baseline: bootstrap test-harness proofs compiler
	$(PYTHON) perf/bench.py --output perf/results/baseline.json
